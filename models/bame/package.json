{
  "name": "@phylo-workbench/model-bame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-parallel FAME/FLAVOR ports and the exploratory Glamma branch-site scan",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-source": "./src/browser.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench:transitions": "node --import tsx scripts/compare-transition-engines.ts",
    "bench:glamma": "node --import tsx scripts/run-global-gamma-demo.ts",
    "bench:global-gamma": "npm run bench:glamma",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phylo-workbench/domain": "*",
    "@phylo-workbench/model-diffubar": "*",
    "@phylo-workbench/model-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
